# Jira Cloud
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=your-atlassian-login-email@example.com
JIRA_API_TOKEN=paste-your-jira-api-token-here
JIRA_PROJECT_KEY=TYN
JIRA_DATASET_LABEL=tyn-release-assessment-v2
JIRA_ISSUE_TYPE=Task

# Google Gemini REST function-calling agent
GEMINI_API_KEY=paste-your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MIN_INTERVAL_SECONDS=5

# Local files
REPORT_DIR=reports

# Hosted deployment only (the dashboard and live assessments are public)
# HOST=0.0.0.0
# PORT=10000
# PUBLIC_BASE_URL=https://your-service.onrender.com
