# Jira Cloud
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=your-atlassian-login-email@example.com
JIRA_API_TOKEN=paste-your-jira-api-token-here
JIRA_PROJECT_KEY=TYN
JIRA_DATASET_LABEL=tyn-release-assessment-v2
JIRA_ISSUE_TYPE=Task

# Model provider: groq or ollama (both use an OpenAI-compatible tool-calling API)
LLM_PROVIDER=groq

# Ollama Cloud (https://ollama.com/settings/keys). For a local server set
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1 and leave the key empty.
OLLAMA_API_KEY=paste-your-ollama-api-key-here
OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_BASE_URL=https://ollama.com/v1

# Groq. The GROQ_* pacing/token settings below apply to either provider
# (LLM_MIN_INTERVAL_SECONDS etc. take precedence when set).
GROQ_API_KEY=paste-your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MIN_INTERVAL_SECONDS=5
GROQ_REQUEST_TIMEOUT_SECONDS=90
GROQ_MAX_COMPLETION_TOKENS=4096

# Assessment defaults (CLI flags override). Batch size 1 = individual reads; 2-3 = evidence bundles.
JIRA_RELEASE=R2.4
AGENT_BATCH_SIZE=3
AGENT_TIMEOUT_SECONDS=1200

# Local files
REPORT_DIR=reports

# Hosted deployment only (the dashboard and live assessments are public)
# HOST=0.0.0.0
# PORT=10000
# PUBLIC_BASE_URL=https://your-service.onrender.com
